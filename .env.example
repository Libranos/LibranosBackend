# Copie este arquivo para .env e preencha os valores reais.
# O .env NUNCA deve ser commitado — ele já está no .gitignore.

# ── Banco de dados ──────────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=root_secret
DB_USER=libranos
DB_PASSWORD=libranos_pass

# ── Spring Boot ─────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=docker

# ── JWT ─────────────────────────────────────────────────────────────────────────
# Gere um novo segredo para produção:
#   openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-forte-de-64-chars-em-producao
JWT_EXPIRATION=3600000

# ── JVM (opcional) ──────────────────────────────────────────────────────────────
# JAVA_TOOL_OPTIONS=-Xmx512m -Xms256m
